{
  "$meta": {
    "brand": "Hello Sugar",
    "description": "Canonical design tokens for Hello Sugar internal tools. This file is the single source of truth. Edit values here, then run `python generate.py` to regenerate variables.css and tailwind-preset.js. Do not hand-edit the generated files.",
    "version": "1.0.0"
  },

  "brand": {
    "crimson": "#ED1845",
    "blush":   "#F7DCDA",
    "rose":    "#AD4C52",
    "sand":    "#E2CCB9",
    "tan":     "#D3AD90",
    "caramel": "#BB8265",
    "taupe":   "#8F7067",
    "mauve":   "#CBA499",
    "cream":   "#EEE2DA"
  },

  "color": {
    "primary":        "#ED1845",
    "primary-strong": "#C9143B",
    "primary-soft":   "#F7DCDA",
    "on-primary":     "#FFFFFF",

    "accent":         "#BB8265",
    "accent-soft":    "#E2CCB9",
    "deep":           "#AD4C52",

    "bg":             "#EEE2DA",
    "surface":        "#FFFFFF",
    "surface-alt":    "#F7F2EE",
    "border":         "#D9C9C1",
    "border-strong":  "#CBA499",

    "text":           "#1F1917",
    "text-muted":     "#8F7067",
    "text-subtle":    "#CBA499",
    "on-dark":        "#FFFFFF",

    "focus":          "#ED1845",

    "success":        "#3F7D5B",
    "success-soft":   "#DBEBE1",
    "warning":        "#B9772E",
    "warning-soft":   "#F3E4D0",
    "danger":         "#C0142F",
    "danger-soft":    "#F7DCDA",
    "info":           "#5B7C8F",
    "info-soft":      "#DEE8ED"
  },

  "font": {
    "sans":    "\"Montserrat\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "display": "\"LiebeLotte\", \"Fifita\", \"Montserrat\", cursive",
    "alt":     "\"Montserrat Alternates\", \"Montserrat\", sans-serif"
  },

  "font-weight": {
    "light": "300",
    "regular": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },

  "font-size": {
    "xs":  "0.75rem",
    "sm":  "0.875rem",
    "base":"1rem",
    "lg":  "1.125rem",
    "xl":  "1.25rem",
    "2xl": "1.5rem",
    "3xl": "1.875rem",
    "4xl": "2.25rem",
    "5xl": "3rem"
  },

  "line-height": {
    "tight":  "1.15",
    "snug":   "1.3",
    "normal": "1.5",
    "relaxed":"1.65"
  },

  "radius": {
    "sm":   "6px",
    "md":   "10px",
    "lg":   "16px",
    "xl":   "24px",
    "pill": "999px"
  },

  "space": {
    "1":  "0.25rem",
    "2":  "0.5rem",
    "3":  "0.75rem",
    "4":  "1rem",
    "5":  "1.25rem",
    "6":  "1.5rem",
    "8":  "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },

  "shadow": {
    "sm": "0 1px 2px rgba(31, 25, 23, 0.06)",
    "md": "0 4px 12px rgba(31, 25, 23, 0.08)",
    "lg": "0 12px 32px rgba(31, 25, 23, 0.12)"
  }
}
